# ---- Gemini (Google AI Studio) ------------------------------------------
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-ai-studio-key-here

# ---- BigQuery -----------------------------------------------------------
# Your own GCP project. Public-dataset STORAGE is free, but queries bill to
# YOUR project, so a project is required. The BigQuery Sandbox needs no
# billing account (1 TiB/month free compute).
GCP_PROJECT_ID=your-project-id

# Auth, pick ONE:
#   (a) gcloud ADC  - winget install Google.CloudSDK
#                     gcloud auth application-default login
#                     (leave GOOGLE_APPLICATION_CREDENTIALS unset)
#   (b) service account JSON - no SDK install needed
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/key.json

# ---- Model routing (never hardcode model IDs in source) -----------------
# Gemini 2.5 is access-restricted as of Oct 2026. Run `doctor` to confirm
# what this key can actually reach before relying on any of these.
MODEL_TRIAGE=gemini-3.5-flash-lite
MODEL_SQL=gemini-3.8-flash
MODEL_SYNTHESIS=gemini-3.8-flash
MODEL_EMBEDDING=gemini-embedding-001

# ---- Cost ceilings (R5: "without inflating costs") ----------------------
MAX_BYTES_BILLED=2000000000
MAX_LLM_CALLS_PER_TURN=6
MAX_SQL_REPAIR_ATTEMPTS=2
MAX_PLAN_STEPS=3

# ---- Demo identity (R2: entitlements) -----------------------------------
ACTIVE_USER=exec_women_apparel

# live | record | replay   (replay runs with no credentials at all)
BQ_MODE=live
