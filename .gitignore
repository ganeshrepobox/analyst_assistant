# Secrets — never commit
.env
*-service-account*.json
*credentials*.json
gcp-key*.json

# Local state
# -wal and -shm suffixes do not match *.sqlite, which is how the checkpointer's
# write-ahead log ended up tracked and pushed.
*.sqlite
*.sqlite-*
*.sqlite3
*.db
logs/
.cache/
fixtures/*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# The assignment brief itself. Deliberately NOT published: the repo is public and
# the client reuses this assignment. Requirements are restated in docs/ instead.
AI Technical Assignment.md

# Local runtime state
checkpoints.sqlite*

# Tool caches and build artefacts
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
