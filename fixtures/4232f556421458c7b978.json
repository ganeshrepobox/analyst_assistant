{
  "sql": "WITH s_products AS (\n  SELECT\n    id,\n    cost,\n    category,\n    name,\n    brand,\n    retail_price,\n    department,\n    sku,\n    distribution_center_id\n  FROM `bigquery-public-data.thelook_ecommerce.products`\n), s_order_items AS (\n  SELECT\n    oi.id,\n    oi.order_id,\n    oi.user_id,\n    oi.product_id,\n    oi.inventory_item_id,\n    oi.status,\n    oi.created_at,\n    oi.shipped_at,\n    oi.delivered_at,\n    oi.returned_at,\n    oi.sale_price\n  FROM `bigquery-public-data.thelook_ecommerce.order_items` AS oi\n  JOIN s_products AS sp\n    ON sp.id = oi.product_id\n), s_orders AS (\n  SELECT\n    o.order_id,\n    o.user_id,\n    o.status,\n    o.gender,\n    o.created_at,\n    o.returned_at,\n    o.shipped_at,\n    o.delivered_at\n  FROM `bigquery-public-data.thelook_ecommerce.orders` AS o\n  WHERE\n    o.order_id IN (\n      SELECT\n        order_id\n      FROM s_order_items\n    )\n), s_users AS (\n  SELECT\n    u.id,\n    u.age,\n    u.gender,\n    u.state,\n    u.city,\n    u.country,\n    u.traffic_source,\n    u.created_at\n  FROM `bigquery-public-data.thelook_ecommerce.users` AS u\n)\nSELECT\n  u.state,\n  p.category,\n  COUNT(DISTINCT oi.order_id) AS orders,\n  COUNT(oi.id) AS units_sold,\n  ROUND(SUM(oi.sale_price), 2) AS net_revenue\nFROM s_order_items AS oi\nJOIN s_orders AS o\n  ON o.order_id = oi.order_id\nJOIN s_users AS u\n  ON u.id = oi.user_id\nJOIN s_products AS p\n  ON p.id = oi.product_id\nWHERE\n  NOT o.status IN ('Cancelled', 'Returned') AND u.state IN ('Texas', 'California')\nGROUP BY\n  u.state,\n  p.category\nORDER BY\n  u.state,\n  net_revenue DESC\nLIMIT 100",
